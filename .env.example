# --- Inference ---
OLLAMA_HOST=http://localhost:11434
JUDGE_MODEL=bvassie/gemma4:12b-it-qat-mtp
VERIFIER_MODEL=bvassie/gemma4:12b-it-qat-mtp
# Pin the weights, not the tag. Fill from `ollama show <model>` once; a silent
# re-pull can then no longer change stored decisions unnoticed.
JUDGE_DIGEST_PIN=
VERIFIER_DIGEST_PIN=
# Ollama's own default is 4096 and it truncates SILENTLY. Always set this.
NUM_CTX=8192
# Unset output caps truncate JSON mid-object; the schema error hides the cause.
NUM_PREDICT=1536
# The verifier reads a full resume plus every `none` criterion in one call, so
# it needs materially more room than the judge.
VERIFIER_NUM_CTX=16384
VERIFIER_NUM_PREDICT=4096
# Reasoning tokens are billed against num_predict and break 10.1's arithmetic:
# the model spends its output budget thinking and the JSON truncates.
DISABLE_THINKING=true
TEMPERATURE=0.0
TOP_K=1
SEED=42
KEEP_ALIVE=30m
# Phase 2 reads a full resume at VERIFIER_NUM_CTX on a 12b model, slower than
# anything phase 1 does.
REQUEST_TIMEOUT_S=300
MAX_RETRIES=2

# NOTE: set OLLAMA_NUM_PARALLEL=1 in the SERVICE environment, not here.
# Slot reuse is the largest remaining source of run-to-run variation.

# --- Verification ---
VERIFICATION_ENABLED=true
# `none` turns the second-model verify_support check off entirely — measured
# as adding no catch beyond Stage B's Python check, at the cost of a full
# second GPU call per candidate. Flip to `all` or `must_have_and_borderline`
# to re-enable it. confirm_absence (the other check) always runs regardless.
VERIFY_SCOPE=none
BORDERLINE_RATIO_MAX=0.75

# --- Budget ---
MAX_RESUME_TOKENS=4200
MAX_CRITERIA=12
EXACT_TOKEN_COUNT=true
TOKEN_ESTIMATE_SAFETY_MARGIN=1.35

# --- File intake ---
MAX_FILE_BYTES=5242880
MAX_PAGES=50
MAX_DECOMPRESSED_BYTES=52428800
MAX_COMPRESSION_RATIO=100
PARSE_TIMEOUT_S=60
# 2048, not 1024. Measured: the parser's resident set is ~270 MB but it maps
# ~2.9 GB virtual, and the lower limit killed every parse. Below 1536 the
# sandbox refuses to start rather than fail one file at a time.
PARSE_MEM_LIMIT_MB=2048
# JSON array — pydantic-settings parses list/tuple fields as JSON, not CSV.
ALLOWED_EXTENSIONS=[".pdf", ".docx"]

# --- Safety / fairness ---
REDACT_PII=true
INJECTION_DETECTION=true
# The three below are combined with AND. Any one alone admits fabricated evidence.
EVIDENCE_MATCH_RATIO=0.60
# 16, not 25. Recalibrated from a sweep over the labelled set: 25 escalated
# three verbatim-correct short quotes and rejected no bad ones that 16 admits.
EVIDENCE_MATCH_MIN_CHARS=16
EVIDENCE_MIN_BLOCK_TOKENS=3
# How far back to look for a negation marker before a verified quote. Six
# tokens covers "has no production experience with" without reaching into
# the previous bullet.
NEGATION_WINDOW_TOKENS=6
FREETEXT_SCREEN=true
# Left unset on purpose upstream (settings.py) — 3% was a guess, and a guessed
# budget reads as a measurement in every report that quotes it. Setting it
# here overrides that; if you do, also set ESCALATION_BUDGET_SOURCE_RUN below
# to the run it was measured from, so the number can be traced and revisited.
ESCALATION_BUDGET=0.03
ESCALATION_BUDGET_SOURCE_RUN=

# --- Ranking ---
# JSON array of the three band cut points (high/mid/low).
BAND_THRESHOLDS=[7.5, 5.5, 3.5]

# --- Review / UI ---
BULK_DECISION_ENABLED=true
# Do not disable. Candidates are review_required precisely because the system
# could not be confident about them — a bulk action over them switches off
# the oversight control through the interface.
BULK_EXCLUDES_REVIEW_REQUIRED=true

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
AUTH_MODE=stub
DEV_ACTOR_ID=poc-operator

# --- Reviewer interface ---
# The built React bundle, served by the API at /ui/. Build it with
# `npm --prefix web run build`. Left unbuilt, the API serves its endpoints and
# nothing at /ui/ — which is what you want while `npm run dev` is holding it.
WEB_DIST_DIR=web/dist

# --- Worker ---
# Leave this UNSET unless you run more than one worker on a host. The default is
# the hostname, which is what crash recovery matches on: it must be stable across
# restarts and unique per worker. A constant like `worker-1` shared through a
# common .env gives two hosts the same name, and they then reset each other's
# in-flight jobs at startup. The systemd unit sets it to %H after reading this
# file, so a value here no longer silently wins — but an unset variable is still
# the clearer way to say "use the default".
# WORKER_ID=
WORKER_POLL_INTERVAL_S=2
HEARTBEAT_INTERVAL_S=15
JOB_MAX_ATTEMPTS=3
# Last-resort lease sweep, behind startup reclaim-by-name. Deliberately huge —
# sized against the worst case a job can legitimately take (~30 min), not the
# typical one. Do not shorten toward that number; a shorter lease needs a
# heartbeat, and there isn't one.
JOB_LEASE_TIMEOUT_S=21600
LEASE_SWEEP_INTERVAL_S=600
# Drives the ETA shown to reviewers. Re-measure and update whenever the model
# or NUM_CTX changes — a stale estimate is worse than none.
SECONDS_PER_RESUME=5.4

# --- Storage / observability ---
# **Required.** Postgres is the only backend; SQLite was removed. There is no
# default because the URL carries a password and a default that silently
# connects somewhere is worse than a startup that refuses to.
#
# Percent-encode reserved characters in the password (@ : / ? # are the ones
# that bite) or the URL parses into the wrong pieces.
DB_URL=postgresql+psycopg://screener:pick-a-password@localhost:5432/screener
# Connection pool, per process. Ignored in practice by SQLite (one file, one
# writer) but still bounds descriptors. pool_recycle matters for
# Postgres/pgbouncer, which drop idle connections server-side.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_S=1800
# RESUMES_DIR may point at a local folder or a mounted network share (e.g. /srv/hr/requisitions).
# Note: if deploying with systemd, the mount must be outside /home because ProtectHome=yes.
RESUMES_DIR=./resumes

QUARANTINE_DIR=data/quarantine
# Raw model output, captured only on a schema failure (bounded — this is not
# continuous tracing, which was removed). Still candidate text: 0700 and
# inside the erasure path.
CAPTURE_RAW_ON_FAILURE=true
FAILURE_DIR=data/failures
LOG_DIR=data/logs
# Readiness gate on the LOCAL volume only — failure captures, logs, quarantine.
# It no longer measures the database: candidate text lives in Postgres now, on a
# volume this process may not be able to see. Size that one separately; a
# 1,000-CV run adds roughly 40 MB of resume_text + sent_text to it.
MIN_FREE_DISK_GB=20
