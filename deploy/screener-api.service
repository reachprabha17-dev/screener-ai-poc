[Unit]
# Also serves the reviewer interface at /ui/ from web/dist. There is no separate
# UI unit any more: the interface is a React bundle, so the thing that used to be
# a Python process holding a socket is now a directory of static files. Same
# origin as the API, which is why the API needs no CORS and the browser has no
# second host to be pointed at.
Description=Screener API — control plane and reviewer interface (spec 15)
# **Postgres, not just the network.** The first thing this process does is the
# migration gate, which now opens a connection rather than reading a local file.
# With `After=network.target` alone a boot where Postgres is a few seconds behind
# produces a process that exits and gets restarted by `Restart=on-failure`, and
# the journal says "connection refused" rather than "not up yet". The app also
# waits for the database itself (`connection.wait_for_database`); this is the
# half that stops the loop from starting at all.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=screener
Group=screener
WorkingDirectory=/opt/screener

Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/screener/.env

# Bound to loopback. There is no external listener before real authentication
# exists (15.2) — `auth_mode=stub` trusts a header, so anything that can reach
# this port is an admin.
# `--factory`: the app is built by a function, not created at import. The
# migration gate (12.1) therefore runs once at startup rather than as an
# import side effect.
ExecStart=/opt/screener/.venv/bin/uvicorn screener.api.app:create_app --factory \
    --host 127.0.0.1 --port 8000

# The bundle is resolved relative to WorkingDirectory unless set absolutely.
# Build it during deployment with `npm --prefix web ci && npm --prefix web run
# build`; the API serves whatever is there at startup, and serves the API alone
# if nothing is.
Environment=WEB_DIST_DIR=/opt/screener/web/dist

# No screening happens here, so a stop only has to drain in-flight HTTP requests.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=5

# --- hardening ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/opt/screener/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
